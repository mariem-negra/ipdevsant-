{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block main %}
  <section id="call-to-action" class="call-to-action section accent-background">
    <div class="container">
      <div class="row justify-content-center" data-aos="zoom-in" data-aos-delay="100">
        <div class="col-xl-10">
          <div class="text-center">
            <h1>Commandes</h1>

            <table class="table">
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Prénom</th>
                  <th>Email</th>
                  <th>telephone</th>
                  <th>Adresse</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for commande in commandes %}
                  <tr>
                    <td>{{ commande.nom }}</td>
                    <td>{{ commande.prenom }}</td>
                    <td>{{ commande.email }}</td>
                    <td>{{ commande.phoneNumber}}</td>
                    <td>{{ commande.adresse }}</td>
                    
                    <td>
                      <a href="{{ path('app_commande_show', {'id': commande.id}) }}">
                        <button class="btn btn-info">Afficher</button>
                      </a>
                      <a href="{{ path('app_commande_edit', {'id': commande.id}) }}">
                        <button class="btn btn-warning">Edit</button>
                    </a>
                    
                    {# Include the delete form #}
                    <form action="{{ path('app_commande_delete', {'id': commande.id}) }}" method="post" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
                        <button type="submit" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this product?');">Delete</button>
                    </form>
                    </td>
                  </tr>
                  
                {% else %}
                  <tr>
                    <td colspan="6" class="text-center">Aucun enregistrement trouvé</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <a href="{{ path('app_commande_new') }}" class="btn btn-success">Créer une nouvelle commande</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    }
    h1 {
      color: #333;
      text-align: center;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .table th, .table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    .table th {
      background-color: #888;
      color: white;
    }
    .table tr:hover {
      background-color: #f5f5f5;
    }
    .table a {
      color: inherit;
      text-decoration: none;
    }
    .btn {
      background-color: #2faac1;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
      border: none;
      cursor: pointer;
    }
    .btn:hover {
      background-color: #8005c2;
    }
    .btn-info {
      background-color: #2faac1;
    }
    .btn-success {
      background-color: #47a832;
    }
    .btn-success:hover {
      background-color: #398727;
    }
    .btn-warning {
      background-color: #ffa500;
    }
    .btn-delete {
      background-color: #ff3300; /* Red for delete */
    }
    .btn-delete:hover {
      background-color: #cc2900;
    }
  </style>
{% endblock %}
