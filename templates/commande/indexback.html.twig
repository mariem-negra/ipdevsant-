{% extends 'baseBack.html.twig' %}

{% block title %}commande{% endblock %}

{% block body %}
  <section id="call-to-action" class="call-to-action section accent-background">

      <div class="container">
        <div class="row justify-content-center" data-aos="zoom-in" data-aos-delay="100">
          <div class="col-xl-10">
            <div class="text-center">
              <h1>commande</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Adresse</th>
                <th>stripeSessionId</th>
                <th>paymentStatus</th>
                <th>totalAmount</th>
                <th>phoneNumber</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id}}</td>
                <td>{{ commande.nom }}</td>
                <td>{{ commande.prenom }}</td>
                <td>{{ commande.email }}</td>
                <td>{{ commande.adresse }}</td>
                <td>{{ commande.stripeSessionId }}</td>
                <td>{{ commande.paymentStatus}}</td>
                <td>{{ commande.totalAmount}}</td>
                <td>{{ commande.phoneNumber}}</td>
                <td>
                    <a href="{{ path('app_commande_showback', {'id': commande.id}) }}">
                        <button class="btn btn-info">Afficher</button>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun enregistrement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_commande_new') }}">Créer un nouvel commande</a>
            </div>
          </div>
        </div>
      </div>

    </section><!-- /Call To Action Section -->
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            padding: 20px;
        }
        h1 {
            color: #333;
            text-align: center;
        }
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .table th, .table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .table th {
            background-color: rgb(53, 77, 233);
            color: white;
        }
        .table tr:hover {
            background-color: #f5f5f5;
        }
        .table a {
            color: inherit;
            text-decoration: none;
        }
        .btn {
            background-color: rgb(47, 173, 193);
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            background-color: rgb(128, 5, 194);
        }
        .btn-info {
            background-color: rgb(53, 77, 233);
        }
        .btn-warning {
            background-color: rgb(255, 165, 0);
        }
        .btn-success {
            background-color: rgb(47, 173, 193);
        }
        .btn-delete {
            background-color: rgb(255, 51, 0); /* Red color for delete */
        }
        .btn-delete:hover {
            background-color: rgb(255, 0, 0); /* Darker red on hover */
        }
    </style>
    
{% endblock %}
