{% block main %}
<section id="produit" class="pricing section">
  <div class="container">
    <!-- Breadcrumb Navigation -->
    <div class="breadcrumb-nav">
      <a href="{{ path('app_home') }}">Shop</a> &gt;
      <a href="#">Equipment</a> &gt;
      <a href="#">General Diagnostics</a> &gt;
      <span class="current-page">Produits</span>
    </div>

    <div class="row">
      <!-- Left Sidebar -->
      <div class="col-lg-3 sidebar">
        <div class="sidebar-section">
          <h3 class="sidebar-title">Produits</h3>
          <ul class="sidebar-categories">
            <li><a href="#">ABI Systems</a></li>
            <li><a href="#">Electronic Produits</a></li>
            <li><a href="#">Manual Produits</a></li>
            <li><a href="#">24h Produits</a></li>
            <li><a href="#">Produit Cuffs</a></li>
            <li><a href="#">Accessories</a></li>
          </ul>
        </div>

        <div class="sidebar-section">
          <h3 class="sidebar-title">Filters</h3>
          <div class="filter-group">
            <h4 class="filter-title">Brand <i class="bi bi-chevron-down"></i></h4>
          </div>
          <div class="filter-group">
            <h4 class="filter-title">Discounts <i class="bi bi-chevron-down"></i></h4>
          </div>
          <div class="filter-group">
            <h4 class="filter-title">Service options <i class="bi bi-chevron-down"></i></h4>
          </div>
          <div class="filter-group">
            <h4 class="filter-title">Price <i class="bi bi-chevron-down"></i></h4>
            <div class="price-slider">
              <input type="range" class="form-range" min="0" max="2000" id="priceRange">
              <div class="price-range-values">
                <span>€4.52</span>
                <span>€2118.20</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-9">
        <div class="products-header">
          <h1 class="products-title">Nos Produits</h1>
          <div class="products-controls">
            <div class="sort-by">
              <span>Sort by:</span>
              <select class="form-select">
                <option selected>Recommendation</option>
                <option>Price: Low to High</option>
                <option>Price: High to Low</option>
                <option>Newest</option>
              </select>
            </div>
            <div class="products-per-page">
              <span>Products per Page:</span>
              <select class="form-select">
                <option selected>36</option>
                <option>24</option>
                <option>12</option>
              </select>
            </div>
          </div>
        </div>
            <div class="search-container">
    <input type="text" id="product-search" class="form-control" placeholder="Rechercher un produit..." autocomplete="off">
</div>
    

        <!-- Product Grid -->
        <div class="product-grid">
          {% for produit in produits %}
            <div class="product-card {% if produit.stockQuantite == 0 %}sold-out{% endif %}">
              <div class="product-brand">{{ produit.brand|default('Brand') }}</div>
              <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="product-image-link">
                <div class="product-image-container">
                  {% set images = produit.image|split(',') %}
                  <img src="{{ asset('uploads/images/' ~ images[0]) }}" alt="{{ produit.nom }}" class="product-image">
                  
                </div>
              </a>
              <div class="product-info">
                <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="product-title">{{ produit.nom }}</a>
                <p class="product-description">{{ produit.description|default('Dual-tube measurement with velcro cuff')|slice(0, 80) }}{% if produit.description|length > 80 %}...{% endif %}</p>
                {% if produit.rating is defined %}
                  <div class="product-rating">
                    {% for i in 1..5 %}
                      <i class="bi {% if i <= produit.rating %}bi-star-fill{% else %}bi-star{% endif %}"></i>
                    {% endfor %}
                  </div>
                {% endif %}
                <div class="product-price">
                  <span class="from-text">from</span>
                  <span class="price-amount">{{ produit.prix }} TND</span>
                  <span class="price-tax">ex. VAT*</span>
                </div>
              </div>
            </div>
          {% else %}
            <p class="text-center">Aucun produit trouvé.</p>
          {% endfor %}
        </div>

        <!-- Bottom Pagination -->
        
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    console.log("Page loaded!");
    updatePanierCount();
    
    // Initialize price range slider
    const priceRange = document.getElementById('priceRange');
    if (priceRange) {
        priceRange.addEventListener('input', function() {
            // Handle price range changes
        });
    }
});

function updatePanierCount() {
    fetch('/panier-count')
    .then(response => response.json())
    .then(data => {
        document.getElementById('panier-count').textContent = data.count ?? 0;
    })
    .catch(error => console.error("Erreur lors de la récupération du panier:", error));
}

function addTopanier(id) {
    fetch('/add-to-panier/' + id, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ quantity: 1 })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('panier-count').textContent = data.count;
            showNotification(data.message, 'success');
        } else {
            showNotification(data.message, 'warning');
        }
    })
    .catch(error => {
        console.error("Erreur lors de l'ajout au panier:", error);
        showNotification("Une erreur est survenue", 'error');
    });
}

function showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.textContent = message;
    
    // Remove any existing notifications
    const existingNotifications = document.querySelectorAll('.notification');
    existingNotifications.forEach(notif => notif.remove());
    
    document.body.appendChild(notification);
    
    // Remove notification after 3 seconds
    setTimeout(() => {
        notification.remove();
    }, 3000);
}


// Add this JavaScript at the bottom of your template or in a separate JS file
document.addEventListener("DOMContentLoaded", function() {
    const searchInput = document.getElementById('product-search');
    let searchTimeout = null;
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.trim();
            
            // Clear previous timeout
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }
            
            // Set a timeout to avoid too many requests while typing
            searchTimeout = setTimeout(function() {
                performSearch(searchTerm);
            }, 500); // Wait 500ms after user stops typing
        });
    }
});

function performSearch(searchTerm) {
    // Show loading indicator
    const productsContainer = document.querySelector('.product-grid');
    if (productsContainer) {
        productsContainer.classList.add('loading');
    }
    
    fetch(`/produit/search-products?q=${encodeURIComponent(searchTerm)}`, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        // Check HTTP response status
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(text || `HTTP error! Status: ${response.status}`);
            });
        }
        return response.text();
    })
    .then(html => {
        if (productsContainer) {
            productsContainer.innerHTML = html;
            productsContainer.classList.remove('loading');
        }
    })
    .catch(error => {
        console.error("Error during search:", error);
        if (productsContainer) {
            productsContainer.classList.remove('loading');
            // Display the error message from the server if available
            productsContainer.innerHTML = `<p class="error-message">${error.message || 'Une erreur est survenue pendant la recherche.'}</p>`;
        }
    });
}


document.addEventListener("DOMContentLoaded", function () {
    console.log("Page loaded!");
    updatePanierCount();
    
    // Initialize price range slider with more functionality
    const priceRange = document.getElementById('priceRange');
    const minPriceDisplay = document.querySelector('.price-range-values span:first-child');
    const maxPriceDisplay = document.querySelector('.price-range-values span:last-child');
    
    if (priceRange) {
        // Set min and max values from the display
        const minPrice = parseFloat(minPriceDisplay.textContent.replace('€', ''));
        const maxPrice = parseFloat(maxPriceDisplay.textContent.replace('€', ''));
        
        priceRange.min = minPrice;
        priceRange.max = maxPrice;
        priceRange.value = maxPrice; // Start with max value selected
        
        priceRange.addEventListener('input', function() {
            // Update the displayed max price as the slider moves
            const selectedPrice = parseFloat(this.value);
            maxPriceDisplay.textContent = '€' + selectedPrice.toFixed(2);
        });
        
        priceRange.addEventListener('change', function() {
            // When slider is released, filter products
            filterProductsByPrice(minPrice, parseFloat(this.value));
        });
        
        // Add button for applying filter
        const filterButton = document.createElement('button');
        filterButton.className = 'btn btn-sm btn-primary mt-2';
        filterButton.textContent = 'Appliquer';
        filterButton.addEventListener('click', function() {
            filterProductsByPrice(minPrice, parseFloat(priceRange.value));
        });
        
        // Insert button after the price slider
        const priceSliderContainer = document.querySelector('.price-slider');
        priceSliderContainer.appendChild(filterButton);
    }
});
function filterProductsByPrice(minPrice, maxPrice) {
    // Show loading indicator
    const productsContainer = document.querySelector('.product-grid');
    if (productsContainer) {
        productsContainer.classList.add('loading');
    }
    
    // Make AJAX request to server with price range parameters
    // Use the correct URL (check your browser's network tab to see the actual path)
    fetch('/filter-products', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ min: minPrice, max: maxPrice })
    })
    .then(response => {
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(text || `HTTP error! Status: ${response.status}`);
            });
        }
        return response.text();
    })
    .then(html => {
        if (productsContainer) {
            productsContainer.innerHTML = html;
            productsContainer.classList.remove('loading');
            
            // Show confirmation message
            showNotification(`Produits filtrés: ${minPrice.toFixed(2)} - ${maxPrice.toFixed(2)} TND`, 'success');
        }
    })
    .catch(error => {
        console.error("Error during price filtering:", error);
        if (productsContainer) {
            productsContainer.classList.remove('loading');
            productsContainer.innerHTML = `<p class="error-message">Une erreur est survenue pendant le filtrage: ${error.message}</p>`;
        }
    });
}
</script>

