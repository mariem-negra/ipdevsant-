    background-color:  #3fbbc0;;
}

/* Panier Icon */
.panier-icon {
    position: fixed;
    top: 20px;
    right: 20px;
    font-size: 24px;
    background: white;
    padding: 15px;
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.panier-icon:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
}

.panier-icon span {
    background: red;
    color: white;
    border-radius: 50%;
    padding: 4px 8px;
    font-size: 14px;
    position: absolute;
    top: -5px;
