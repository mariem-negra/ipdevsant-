/* Notifications */
.notification {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 15px 25px;
    border-radius: 5px;
    color: white;
    z-index: 1001;
    font-size: 14px;
    font-weight: 600;
    animation: slideIn 0.5s ease;
}

@keyframes slideIn {
    from {
        top: -50px;
    }
    to {
        top: 20px;
    }
}

.notification.success { background-color: #28a745; }
.notification.warning { background-color: #ffc107; color: #333; }
.notification.error { background-color: #dc3545; }
</style>

