{% block produit %}
<section id="produit" class="pricing section">
    <div class="container">
        <div class="row justify-content-center" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-12">
                <div class="text-center">
                    <h1 class="section-title">Nos Produits</h1>
                    <p class="section-subtitle">Découvrez nos produits exceptionnels</p>
                </div>

                <!-- Product Grid -->
                <div class="product-scroll-container">
                    <div class="product-grid" id="productGrid">
                        {% for produit in produits %}
                            <div class="product-card" onclick="redirectToIndex()">
                                <div class="product-image-container">
                                    {% set images = produit.image|split(',') %}
                                    <img src="{{ asset('uploads/images/' ~ images[0]) }}" alt="Produit Image" class="product-image">
                                    <span class="discount-badge">-30%</span>
                                    <button class="wishlist-btn" onclick="redirectToIndex()">❤</button>
                                    {% if produit.stockQuantite <= 0 %}
                                        <div class="sold-out-badge">Rupture de stock</div>
                                    {% endif %}
                                </div>
                                <div class="product-info">
                                    <h2 class="product-name">{{ produit.nom }}</h2>
                                    <p class="product-unit">1 UNIT ⭐ 4.5</p>
                                    <p class="product-price">{{ produit.prix }} TND</p>
                                    <p class="stock-info {% if produit.stockQuantite <= 5 %}low-stock{% endif %}">
                                        Stock: {{ produit.stockQuantite }}
                                    </p>
                                </div>
                                <div class="product-actions">
                                
                                    <button class="add-to-panier-btn" onclick="redirectToIndex()"
                                            {% if produit.stockQuantite <= 0 %}disabled{% endif %}>
                                        {% if produit.stockQuantite > 0 %}
                                            🛒 Add to panier
                                        {% else %}
                                            Rupture de stock
                                        {% endif %}
                                    </button>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-center">Aucun produit trouvé.</p>
                        {% endfor %}
                    </div>
                </div>

                <!-- Navigation Arrows -->
                <button class="scroll-arrow left-arrow" onclick="redirectToIndex()">&#10094;</button>
                <button class="scroll-arrow right-arrow" onclick="redirectToIndex()">&#10095;</button>
            </div>
        </div>
    </div>

    <!-- Panier Icon -->
    
</section>
<script>
// Function to redirect to index.html.twig
function redirectToIndex() {
    window.location.href = "{{ path('app_produit_index') }}";
}

// Function to create an infinite circular scrolling product carousel
function initInfiniteCarousel() {
    const productContainer = document.querySelector('.product-scroll-container');
    const productGrid = document.getElementById('productGrid');
    
    if (!productContainer || !productGrid) return;
    
    // Variables to control scroll behavior
    const scrollSpeed = 3; // Increased speed (pixels per frame)
    const scrollStep = 100; // Larger step for arrow clicks
    
    let isScrolling = true;
    
    // Clone items for infinite scroll effect
    const productItems = productGrid.querySelectorAll('.product-card');
    
    // Only proceed if we have products
    if (productItems.length === 0) return;
    
    // Clone the first set of items and append to the end
    productItems.forEach(item => {
        const clone = item.cloneNode(true);
        // Add event listeners to clones
        clone.addEventListener('click', redirectToIndex);
        
        // Add wishlist and add-to-cart button event listeners to clones
        const wishlistBtn = clone.querySelector('.wishlist-btn');
        if (wishlistBtn) {
            wishlistBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                redirectToIndex();
            });
        }
        
        const addToCartBtn = clone.querySelector('.add-to-panier-btn');
        if (addToCartBtn) {
            addToCartBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                redirectToIndex();
            });
        }
        
        productGrid.appendChild(clone);
    });
    
    // Function to handle automatic scrolling
    function autoScroll() {
        if (!isScrolling) {
            requestAnimationFrame(autoScroll);
            return;
        }
        
        // Move scroll position
        productContainer.scrollLeft += scrollSpeed;
        
        // Check if we need to reset (when first set of items has scrolled out of view)
        const firstItemWidth = productItems[0].offsetWidth;
        const itemsWidth = firstItemWidth * productItems.length;
        
        // When we've scrolled past the first set of items, jump back to start
        if (productContainer.scrollLeft >= itemsWidth) {
            productContainer.scrollLeft = 0;
        }
        
        // Continue scrolling with animation frame
        requestAnimationFrame(autoScroll);
    }
    
    // Start the auto-scrolling
    requestAnimationFrame(autoScroll);
    
    // Pause scrolling when hovering over products
    productContainer.addEventListener('mouseenter', () => {
        isScrolling = false;
    });
    
    productContainer.addEventListener('mouseleave', () => {
        isScrolling = true;
    });
    
    // Update the arrow buttons to work with auto-scrolling
    const leftArrow = document.querySelector('.left-arrow');
    const rightArrow = document.querySelector('.right-arrow');
    
    // Remove the redirect behavior and implement proper scrolling
    if (leftArrow) {
        leftArrow.removeEventListener('click', redirectToIndex);
        leftArrow.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            productContainer.scrollLeft -= scrollStep;
        });
    }
    
    if (rightArrow) {
        rightArrow.removeEventListener('click', redirectToIndex);
        rightArrow.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            productContainer.scrollLeft += scrollStep;
        });
    }
}

// Initialize the infinite carousel when the page is fully loaded
document.addEventListener('DOMContentLoaded', function() {
    // Add CSS to hide the scrollbar
    const style = document.createElement('style');
    style.textContent = `
        .product-scroll-container {
            overflow-x: auto;
            white-space: nowrap;
            padding-bottom: 20px;
            position: relative;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE and Edge */
        }
        
        .product-scroll-container::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }
    `;
    document.head.appendChild(style);
    
    const productCards = document.querySelectorAll('.product-card');
    const wishlistBtns = document.querySelectorAll('.wishlist-btn');
    const addToCartBtns = document.querySelectorAll('.add-to-panier-btn');
    
    productCards.forEach(element => {
        element.addEventListener('click', redirectToIndex);
    });
    
    wishlistBtns.forEach(element => {
        element.addEventListener('click', function(e) {
            e.stopPropagation();
            redirectToIndex();
        });
    });
    
    addToCartBtns.forEach(element => {
        element.addEventListener('click', function(e) {
            e.stopPropagation();
            redirectToIndex();
        });
    });
    
    // Initialize the infinite carousel
    initInfiniteCarousel();
});
</script>




