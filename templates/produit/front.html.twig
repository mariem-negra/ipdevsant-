   <style>
    .cart-icon-wrapper {
  position: relative;
  display: inline-block;
  margin-right: 50px;
  text-decoration: none;
}

.cart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #30b4b4; /* Using your teal brand color */
  color: white;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  transition: all 0.3s ease;
