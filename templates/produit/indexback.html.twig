{% extends 'baseBack.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
{% if outOfStockProducts is defined and outOfStockProducts|length > 0 %}
    <div class="alert alert-danger mt-3 stock-notification">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="alert-heading mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Produits en rupture de stock</h5>
            <button type="button" class="btn-close dismiss-all" data-type="out_of_stock" aria-label="Close"></button>
        </div>
        <hr>
        <ul class="mb-0 list-unstyled">
            {% for product in outOfStockProducts %}
                <li class="mb-1 d-flex justify-content-between align-items-center notification-item" data-product-id="{{ product.id }}">
                    <a href="{{ path('app_produit_showback', {'id': product.id}) }}" class="alert-link">
                        {{ product.nom }} <span class="badge bg-danger">Stock: 0</span>
                    </a>
                    <button type="button" class="btn-close dismiss-notification" data-type="out_of_stock" data-product-id="{{ product.id }}" aria-label="Close"></button>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

{% if lowStockProducts is defined and lowStockProducts|length > 0 %}
    <div class="alert alert-warning mt-3 stock-notification">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="alert-heading mb-0"><i class="bi bi-exclamation-circle me-2"></i>Produits à stock limité</h5>
            <button type="button" class="btn-close dismiss-all" data-type="low_stock" aria-label="Close"></button>
        </div>
        <hr>
        <ul class="mb-0 list-unstyled">
            {% for product in lowStockProducts %}
                <li class="mb-1 d-flex justify-content-between align-items-center notification-item" data-product-id="{{ product.id }}">
                    <a href="{{ path('app_produit_showback', {'id': product.id}) }}" class="alert-link">
                        {{ product.nom }} <span class="badge bg-warning text-dark">Stock: {{ product.stockQuantite }}</span>
                    </a>
                    <button type="button" class="btn-close dismiss-notification" data-type="low_stock" data-product-id="{{ product.id }}" aria-label="Close"></button>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
    <div>
        <div class="row mb-4">
            <div class="col-md-6 offset-md-6">
                <div class="input-group">
                    <input type="text" id="search-input" class="form-control" placeholder="Rechercher un produit..." value="{{ searchQuery|default('') }}">
                    <button class="btn btn-info" type="button" id="search-button">
                        <i class="bi bi-search"></i> Rechercher
                        <div class="search-container">
                        
                    </button>
                </div>
            </div>
        </div>
        <div class="text-dark d-flex align-items-center justify-content-between" style="padding: 15px; border-bottom: 2px solid #f0f0f0;">
            <h3 class="card-title m-0 d-flex align-items-center gap-2">
                <i class="bi bi-box-seam text-warning fs-3"></i> 
                <span class="fw-bold fs-3">Liste des Produits :</span>
            </h3>
        </div>
        <div class="card-body">
            <table class="table table-hover table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col" class="text-primary sortable" data-field="id">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-hash"></i> Id
                                
                            </span>
                        </th>
                        <th scope="col" class="text-info sortable" data-field="nom">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-box"></i> Nom
                                
                            </span>
                        </th>
                        <th scope="col" style="color:rgb(49, 243, 247);" class="sortable" data-field="description">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-card-text"></i> Description
                                
                            </span>
                        </th>
                        <th scope="col" style="color:rgb(227, 72, 121);" class="sortable" data-field="prix">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-currency-dollar"></i> Prix
                                
                            </span>
                        </th>
                        <th scope="col" style="color:rgb(133, 192, 243);" class="sortable" data-field="stock_quantite">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-boxes"></i> Stock Quantité
                               
                            </span>
                        </th>
                        <th scope="col" style="color: #ffc107;" class="sortable" data-field="date">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-calendar"></i> Date
                                
                            </span>
                        </th>
                        <th scope="col" style="color: #20c997;">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-image"></i> Image
                            </span>
                        </th>
                        <th scope="col" style="color: #e83e8c;">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-gear"></i> Actions
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody id="produits-table-body">
                    {% for produit in produits %}
                        <tr class="align-middle">
                            <td>{{ produit.id }}</td>
                            <td>{{ produit.nom }}</td>
                            <td>{{ produit.description }}</td>
                            <td>{{ produit.prix }}</td>
                            <td>
                                {% if produit.stockQuantite <= 0 %}
                                    <span class="badge bg-danger">{{ produit.stockQuantite }} - Rupture</span>
                                {% elseif produit.stockQuantite <= 5 %}
                                    <span class="badge bg-warning text-dark">{{ produit.stockQuantite }} - Bas</span>
                                {% else %}
                                    {{ produit.stockQuantite }}
                                {% endif %}
                            </td>
                            <td>{{ produit.date ? produit.date|date('Y-m-d') : '' }}</td>
                            <td>
                                {% if produit.image %}
                                    {% set images = produit.image|split(',') %}
                                    <img src="{{ asset('uploads/images/' ~ images[0]) }}" alt="Produit Image" width="120" height="120">
                                {% else %}
                                    No image uploaded
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <a href="{{ path('app_produit_showback', {'id': produit.id}) }}" class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i> 
                                </a>
                                <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> 
                                </a>
                                <form action="{{ path('app_produit_delete', {'id': produit.id}) }}" method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this product?');">
                                        <i class="bi bi-trash"></i> 
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                <i class="bi bi-exclamation-circle text-secondary"></i> Aucun produit trouvé
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            <div class="d-flex justify-content-end">
                <a href="{{ path('app_produit_new') }}" class="btn px-4 py-2 shadow-lg rounded-pill d-flex align-items-center gap-2" 
                    style="background: linear-gradient(135deg, #ff7eb3, #ff4d4d); border: none; color: white;">
                    <i class="bi bi-plus-circle fs-5"></i> 
                    <span class="fw-bold">Créer un nouveau produit</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        .sortable {
            cursor: pointer;
        }
        .sortable:hover {
            background-color: rgba(0,0,0,0.05);
        }
        .sort-icon {
            margin-left: 5px;
        }
    </style>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Individual notification dismiss
        document.querySelectorAll('.dismiss-notification').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const productId = this.getAttribute('data-product-id');
                const type = this.getAttribute('data-type');
                dismissNotification(productId, type);
                
                // Remove the notification item from DOM
                this.closest('.notification-item').remove();
                
                // If no more notifications of this type, remove entire alert
                const parentAlert = this.closest('.stock-notification');
                if (parentAlert.querySelectorAll('.notification-item').length === 0) {
                    parentAlert.remove();
                }
            });
        });
        
        // Dismiss all notifications of a type
        document.querySelectorAll('.dismiss-all').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const type = this.getAttribute('data-type');
                const parentAlert = this.closest('.stock-notification');
                
                // Dismiss each notification
                parentAlert.querySelectorAll('.notification-item').forEach(item => {
                    const productId = item.getAttribute('data-product-id');
                    dismissNotification(productId, type);
                });
                
                // Remove entire alert
                parentAlert.remove();
            });
        });
        
        // Function to send AJAX request to dismiss notification
        function dismissNotification(productId, type) {
            fetch('{{ path('app_dismiss_notification', {'id': 'PRODUCT_ID'}) }}'.replace('PRODUCT_ID', productId), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'type=' + type
            })
            .then(response => response.json())
            .catch(error => console.error('Error:', error));
        }
    });
    document.addEventListener("DOMContentLoaded", function() {
    const searchInput = document.getElementById('product-search');
    let searchTimeout = null;
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.trim();
            
            // Clear previous timeout
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }
            
            // Set a timeout to avoid too many requests while typing
            searchTimeout = setTimeout(function() {
                performSearch(searchTerm);
            }, 500); // Wait 500ms after user stops typing
        });
    }
});

function performSearch(searchTerm) {
    // Show loading indicator
    const productsContainer = document.querySelector('.product-grid');
    if (productsContainer) {
        productsContainer.classList.add('loading');
    }
    
    fetch(`/produit/search-products?q=${encodeURIComponent(searchTerm)}`, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        // Check HTTP response status
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(text || `HTTP error! Status: ${response.status}`);
            });
        }
        return response.text();
    })
    .then(html => {
        if (productsContainer) {
            productsContainer.innerHTML = html;
            productsContainer.classList.remove('loading');
        }
    })
    .catch(error => {
        console.error("Error during search:", error);
        if (productsContainer) {
            productsContainer.classList.remove('loading');
            // Display the error message from the server if available
            productsContainer.innerHTML = `<p class="error-message">${error.message || 'Une erreur est survenue pendant la recherche.'}</p>`;
        }
    });
}
</script>
       
{% endblock %}