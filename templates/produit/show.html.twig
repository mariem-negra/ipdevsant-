    </div>
  </header>
{% endblock %}
{% block main %}
    <div class="product-container">
        <div class="breadcrumb">
            <a href="{{ path('app_produit_index') }}" class="back-link">
                <span class="back-icon">&#8592;</span>
                <span>Catégorie</span>
            </a>
            <span class="separator">/</span>
            <span class="current-page">{{ produit.nom }}</span>
        </div>

        <div class="product-content">
            <!-- Left column: Product images and thumbnails -->
            <div class="product-images-column">
                <div class="main-image-container">
                    {% if produit.image|split(',')|length > 0 %}
                        {% set mainImage = produit.image|split(',')|first %}
                        <img src="{{ asset('uploads/images/' ~ mainImage) }}" alt="{{ produit.nom }}" class="main-product-image" id="mainImage">
                    {% endif %}
                </div>
                
                <div class="thumbnail-container">
                    {% for image in produit.image|split(',') %}
                        <div class="thumbnail-item" onclick="changeMainImage('{{ asset('uploads/images/' ~ image) }}')">
                            <img src="{{ asset('uploads/images/' ~ image) }}" alt="{{ produit.nom }}" class="thumbnail-image">
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Right column: Product details and actions -->
            <div class="product-details-column">
                <div class="product-brand">{{ produit.marque ?? 'Marque' }}</div>
                <h1 class="product-title">{{ produit.nom }}</h1>
                
                <div class="product-rating">
                    <div class="star-rating">
                        <span class="stars">★★★★★</span>
                        <span class="rating-count">5 <span class="rating-text">sur</span> {{ produit.ratings ?? '13' }} <span class="rating-text">évaluations</span></span>
                    </div>
                    <div class="product-id">
                        <span class="id-label">Art. No.:</span>
                        <span class="id-value">{{ produit.reference ?? '135363W' }}</span>
                    </div>
                    <div class="product-ean">
                        <span class="ean-label">EAN:</span>
                        <span class="ean-value">{{ produit.ean ?? '4260306777716' }}</span>
                    </div>
                </div>

                <div class="product-price-section">
                    <div class="price-container">
                        <span class="current-price">€ {{ produit.prix|number_format(2, ',', '.') }}</span>
                        <span class="price-notes">net</span>
                    </div>
                    <div class="original-price">
                        <span>€ {{ (produit.prix * 1.2)|number_format(2, ',', '.') }} brut</span>
                    </div>
                    <div class="savings-info">
                        <span class="savings-label">Votre <strong>PLUS</strong> économies client</span>
                        <span class="savings-value">€ {{ (produit.prix * 0.05)|number_format(2, ',', '.') }} net</span>
                    </div>
                </div>

                <div class="product-overview">
                    <h2 class="section-title">Aperçu du produit</h2>
                    <ul class="feature-list">
                        <li>Dossier pivote à 360°</li>
                        <li>Idéal pour différentes positions assises</li>
                        <li>Hauteur réglable de 48 - 58 cm</li>
                        <li>Siège Ø: 38 cm</li>
                        <li>Avec anneau de déverrouillage</li>
                    </ul>
                    <p class="product-description">{{ produit.description }}</p>
                </div>

                <div class="delivery-info">
                    <div class="stock-info">
                        <span class="stock-icon">✓</span>
                        <span class="stock-text">En stock. Date de livraison prévue: {{ "now"|date_modify("+3 days")|date("Y-m-d") }} à 18h</span>
                    </div>
                </div>

                <div class="add-to-cart-section">
                    <div class="quantity-selector">
                        <input type="number" min="1" value="1" id="quantity" class="quantity-input">
                    </div>
                    <button class="add-to-panier-btn" onclick="event.stopPropagation(); addTopanier({{ produit.id }})" {% if produit.stockQuantite <= 0 %}disabled{% endif %}>
                                        {% if produit.stockQuantite > 0 %}
                                            🛒 Ajouter au panier
                                        {% else %}
                                            Rupture de stock
                                        {% endif %}
                                    </button>
                </div>
                <div class="wishlist-action">
                    <a href="#" class="wishlist-link">Ajouter à la liste de souhaits</a>
                </div>
            </div>
        </div>

        <div class="additional-info">
            <div class="shipping-info">
                <span class="shipping-icon">🚚</span>
                <span class="shipping-text">Expédition rapide à des prix raisonnables</span>
            </div>
            <div class="delivery-options">
                <span class="delivery-icon">📅</span>
                <span class="delivery-text">Livraison préférée</span>
            </div>
            <div class="discount-info">
                <span class="discount-icon">🏷️</span>
                <span class="discount-text">5% de remise pour les membres PD PLUS</span>
            </div>
            <div class="faq-link">
                <span class="faq-icon">❓</span>
                <span class="faq-text">Questions fréquemment posées</span>
            </div>
        </div>
    </div>

    <!-- Panier Icon -->
    

    <script>
        document.addEventListener("DOMContentLoaded", function () {
    console.log("Page loaded!"); // Debugging line
});

        function addTopanier(id) {
    const quantity = parseInt(document.getElementById('quantity').value);

    fetch('/add-to-panier/' + id, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ quantity: quantity })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update the cart count immediately
            document.querySelector('.cart-count').textContent = data.count;
            showNotification(data.message, 'success');
        } else {
            showNotification(data.message, 'warning');
        }
    })
    .catch(error => {
        console.error("Erreur lors de l'ajout au panier:", error);
        showNotification("Une erreur est survenue", 'error');
    });
}

        function updatePanierCount() {
    fetch('/panier-count')
    .then(response => response.json())
    .then(data => {
        // Update using the correct selector for the cart counter
        document.querySelector('.cart-count').textContent = data.count ?? 0;
    })
    .catch(error => console.error("Erreur lors de la récupération du panier:", error));
}

        function showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.textContent = message;
    
    // Remove any existing notifications
    const existingNotifications = document.querySelectorAll('.notification');
    existingNotifications.forEach(notif => notif.remove());
    
    document.body.appendChild(notification);
    
    // Remove notification after 3 seconds
    setTimeout(() => {
        notification.remove();
    }, 3000);
}


// Enhanced Product Image Zoom Functionality
document.addEventListener("DOMContentLoaded", function() {
    // Get elements
    const mainImage = document.getElementById('mainImage');
    const modalElement = document.querySelector('.image-modal');
    const zoomImage = document.getElementById('zoomImage');
    const closeButton = document.querySelector('.close-button');
    const zoomInButton = document.querySelector('.zoom-in');
    const zoomOutButton = document.querySelector('.zoom-out');
    const zoomResetButton = document.querySelector('.zoom-reset');
    
    // Variables for zoom and drag functionality
    let zoomLevel = 1;
    const zoomStep = 0.2;
    let isDragging = false;
    let startX, startY, translateX = 0, translateY = 0;
    
    // Create modal if it doesn't exist
    if (!modalElement) {
        const modalHTML = `
            <div class="image-modal">
                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <div class="zoom-controls">
                        <button class="zoom-in">+</button>
                        <button class="zoom-out">-</button>
                        <button class="zoom-reset">Reset</button>
                    </div>
                    <div class="image-container">
                        <img id="zoomImage" src="" alt="Zoomed Image">
                    </div>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHTML);
    }
    
    // Get elements again in case they were just created
    const updatedModalElement = document.querySelector('.image-modal');
    const updatedZoomImage = document.getElementById('zoomImage');
    const updatedCloseButton = document.querySelector('.close-button');
    const updatedZoomInButton = document.querySelector('.zoom-in');
    const updatedZoomOutButton = document.querySelector('.zoom-out');
    const updatedZoomResetButton = document.querySelector('.zoom-reset');
    const imageContainer = document.querySelector('.image-container');
    
    // Set up click event on main image
    if (mainImage) {
        console.log("Adding click event to main image");
        mainImage.addEventListener('click', function(e) {
            console.log("Main image clicked");
            e.preventDefault(); // Prevent any default behavior
            openModal(this.src);
        });
        // Add pointer cursor to indicate clickable
        mainImage.style.cursor = 'pointer';
    }
    
    // Modal functions
    function openModal(imageUrl) {
        console.log("Opening modal with image:", imageUrl);
        resetZoom();
        if (updatedZoomImage) {
            updatedZoomImage.src = imageUrl;
            updatedModalElement.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Prevent scrolling
        }
    }
    
    function closeModal() {
        console.log("Closing modal");
        if (updatedModalElement) {
            updatedModalElement.style.display = 'none';
            document.body.style.overflow = 'auto'; // Re-enable scrolling
        }
    }
    
    function zoomIn() {
        zoomLevel += zoomStep;
        updateZoom();
    }
    
    function zoomOut() {
        zoomLevel = Math.max(1, zoomLevel - zoomStep);
        updateZoom();
    }
    
    function resetZoom() {
        zoomLevel = 1;
        translateX = 0;
        translateY = 0;
        updateZoom();
    }
    
    function updateZoom() {
        if (updatedZoomImage) {
            updatedZoomImage.style.transform = `translate(${translateX}px, ${translateY}px) scale(${zoomLevel})`;
        }
    }
    
    // Event listeners for modal controls
    if (updatedCloseButton) {
        updatedCloseButton.addEventListener('click', closeModal);
    }
    
    if (updatedZoomInButton) {
        updatedZoomInButton.addEventListener('click', zoomIn);
    }
    
    if (updatedZoomOutButton) {
        updatedZoomOutButton.addEventListener('click', zoomOut);
    }
    
    if (updatedZoomResetButton) {
        updatedZoomResetButton.addEventListener('click', resetZoom);
    }
    
    // Close modal when clicking outside the image
    if (updatedModalElement) {
        updatedModalElement.addEventListener('click', function(e) {
            if (e.target === updatedModalElement) {
                closeModal();
            }
        });
    }
    
    // Mouse wheel zoom
    if (imageContainer) {
        imageContainer.addEventListener('wheel', function(e) {
            e.preventDefault();
            if (e.deltaY < 0) {
                zoomIn();
            } else {
                zoomOut();
            }
        });
    }
    
    // Drag functions
    function startDrag(e) {
        e.preventDefault();
        isDragging = true;
        
        if (e.type === 'touchstart') {
            startX = e.touches[0].clientX - translateX;
            startY = e.touches[0].clientY - translateY;
        } else {
            startX = e.clientX - translateX;
            startY = e.clientY - translateY;
        }
    }
    
    function drag(e) {
        if (!isDragging) return;
        e.preventDefault();
        
        let newX, newY;
        if (e.type === 'touchmove') {
            newX = e.touches[0].clientX - startX;
            newY = e.touches[0].clientY - startY;
        } else {
            newX = e.clientX - startX;
            newY = e.clientY - startY;
        }
        
        // Apply the translation
        translateX = newX;
        translateY = newY;
        updateZoom();
    }
    
    function endDrag() {
        isDragging = false;
    }
    
    // Set up dragging functionality
    if (updatedZoomImage) {
        updatedZoomImage.addEventListener('mousedown', startDrag);
        updatedZoomImage.addEventListener('touchstart', startDrag, {passive: false});
    }
    
    document.addEventListener('mousemove', drag);
    document.addEventListener('touchmove', drag, {passive: false});
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchend', endDrag);
    
    // Make sure changeMainImage function works with the zoom
    
    
    // Make changeMainImage function global
    window.changeMainImage = function(imageUrl) {
        if (mainImage) {
            mainImage.src = imageUrl;
            
            // Update zoom result background when main image changes
            const zoomResult = document.querySelector('.zoom-result');
            if (zoomResult) {
                zoomResult.style.backgroundImage = `url('${imageUrl}')`;
            }
        }
    };
    
    console.log("Zoom functionality initialized");
});
    </script>

