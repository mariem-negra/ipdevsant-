{% extends 'base.html.twig' %}

{% block title %}{% endblock %}
  
   

{% block section %}
<style>
    /* Header Styles */
    .medical-header {
    background: linear-gradient(135deg, rgb(31, 197, 172), #CAE9FF);
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0 0 25px 25px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

.medical-header h2 {
    color: white;
    font-size: 1.5rem;
    margin: 0;
    text-align: center;
}

/* Table Container */
.table {
    width: 100%;
    margin: 1rem auto;
    border-collapse: collapse;
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
}

/* Table Headers */
.table th {
    background: linear-gradient(135deg, rgb(31, 197, 172), #E6F3FF);
    color: white;
    padding: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
}

/* Table Cells */
.table td {
    padding: 0.6rem;
    font-size: 0.85rem;
    border-bottom: 1px solid #f0f0f0;
}

/* Action Buttons */
.btn {
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    border-radius: 4px;
    margin: 0.1rem;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
}

/* Images in Table */
.table td img {
    max-width: 60px;
    height: auto;
    border-radius: 4px;
}

/* Empty State */
.empty-state {
    padding: 1rem;
    text-align: center;
    color: #666;
}

/* Responsive Design */
@media (max-width: 768px) {
    .table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
    
    .table th, .table td {
        padding: 0.5rem;
        font-size: 0.8rem;
    }
    
    .btn {
        padding: 0.3rem 0.5rem;
        font-size: 0.75rem;
    }
}

/* Button Colors */
.btn-info { background: rgb(31, 197, 172); color: white; }
.btn-warning { background: #f2994a; color: white; }
.btn-primary { background: #4a90e2; color: white; }
.btn-delete { background: #ff416c; color: white; }
.btn-success { background: #00b09b; color: white; }

/* No Bilan Text */
.no-bilan {
    color: #999;
    font-style: italic;
    font-size: 0.8rem;
}
</style>
{% for message in app.flashes('error') %}
    <div class="alert alert-danger animated fadeIn">
        <div class="alert-content">
            <span class="alert-icon">⚠️</span>
            <span class="alert-message">{{ message }}</span>
        </div>
        <span class="alert-close" onclick="this.parentElement.style.display='none';">&times;</span>
    </div>
{% endfor %}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="medical-header">
    <h2>
        <i class="fas fa-hospital-user medical-icon"></i>
        Historique des Traitements
    </h2>
</div>

    <table class="table">
        <thead>
            <tr>
                 <th><i class="fas fa-user-circle"></i> Nom</th>
                <th><i class="fas fa-user-tag"></i> Prénom</th>
                <th><i class="fas fa-virus"></i> Maladie</th>
                <th><i class="fas fa-comment-medical"></i> Description</th>
                <th><i class="fas fa-prescription-bottle-medical"></i> Type Traitement</th>
                <th><i class="fas fa-file-medical-alt"></i> Bilan</th>
                <th><i class="fas fa-stethoscope"></i> Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for historique_traitement in historique_traitement %}
            <tr>
                <td>{{ historique_traitement.nom }}</td>
                <td>{{ historique_traitement.prenom }}</td>
                <td>{{ historique_traitement.maladie }}</td>
                <td>{{ historique_traitement.description }}</td>
                <td>{{ historique_traitement.typeTraitement }}</td>
                <td>
                    {% if historique_traitement.bilan %}
                        <img src="{{ asset('uploads/bilan/' ~ historique_traitement.bilan) }}" alt="Bilan" style="max-width: 100px; height: auto;">
                    {% else %}
                      <span class="no-bilan">Aucun bilan disponible</span>
                     {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_historique_traitement_show', {'id': historique_traitement.id}) }}" 
                       class="btn btn-info">
                        <i class="fas fa-eye"></i> 
                    </a>
                     <a href="{{ path('app_historique_traitement_edit', {'id': historique_traitement.id}) }}" 
                       class="btn btn-warning">
                        <i class="fas fa-edit"></i> 
                    </a>
                    {# Include the delete form #}
                 <button 
                            onclick="checkAndAddSuiviMedical({{ historique_traitement.id }})"
                            class="btn btn-primary"
                        >
                            <i class="fas fa-plus-circle"></i>
                        </button>
                    <form action="{{ path('app_historique_traitement_delete', {'id': historique_traitement.id}) }}" method="post" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ historique_traitement.id) }}">
                        <button type="submit" class="btn btn-delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet élément??');"> <i class="fas fa-trash-alt"></i> </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    Pas de résultats trouvés
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_historique_traitement_new') }}">
        <button class="btn btn-success">   <i class="fas fa-plus-circle"></i> Ajouter un nouveau historique_traitement</button>
    </a>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
function checkAndAddSuiviMedical(historiqueId) {
    fetch(`/suivie/medical/check/${historiqueId}`)
        .then(response => response.json())
        .then(data => {
            if (data.count >= 5) {
                // Show warning if there are already 5 or more suivie medical records
                Swal.fire({
                    title: 'Attention!',
                    text: 'Ce patient a déjà 5 suivis médicaux. Voulez-vous en ajouter un autre?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Oui, ajouter',
                    cancelButtonText: 'Non, annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = `/suivie/medical/new/${historiqueId}`;
                    }
                });
            } else {
                // If less than 5 suivie medical records, proceed directly
                window.location.href = `/suivie/medical/new/${historiqueId}`;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                title: 'Erreur!',
                text: 'Une erreur est survenue lors de la vérification des suivis médicaux.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        });
}
</script>  
   
{% endblock %}
