{% extends 'base.html.twig' %}

{% block title %}Event{% endblock %}

{% block section %}
    <div class="event-container">
        <h1 class="event-title">{{ event.titre }}</h1>
        
        <div class="event-header">
            <!-- Gallery Section -->
            <div class="event-gallery">
                <div class="gallery-grid">
                    {% for image in event.image|split(',') %}
                        {% set imagePath = asset('uploads/images/' ~ image) %}
                        <a href="{{ imagePath }}" class="gallery-item" data-lightbox="event-gallery" data-title="Event Image">
                            <img src="{{ imagePath }}" alt="Event Image" class="gallery-image">
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Details Section -->
            <div class="event-details-card">
                <div class="detail-item">
                    <span class="detail-label">Date:</span>
                    <span class="detail-value">{{ event.dateevent ? event.dateevent|date('d M Y') : '' }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Lieu:</span>
                    <span class="detail-value">{{ event.lieu }}</span>
                </div>
                <div class="detail-item full-width">
                    <span class="detail-label">Description:</span>
                    <p class="detail-description">{{ event.discription }}</p>
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="event-actions">
            <a href="{{ path('app_event_index') }}" class="back-button">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <style>
        .event-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .event-title {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 2rem;
            font-size: 2.5rem;
        }

        .event-header {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            border-radius: 12px;
            overflow: hidden;
        }

        .gallery-item {
            transition: transform 0.3s ease;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 1/1;
        }

        .gallery-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .gallery-item:hover {
            transform: translateY(-5px);
        }

        .event-details-card {
            background: #ffffff;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .detail-item {
            margin-bottom: 1.5rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .detail-label {
            font-weight: 600;
            color: #3498db;
            display: block;
            margin-bottom: 0.5rem;
        }

        .detail-value {
            color: #2c3e50;
            font-size: 1.1rem;
        }

        .detail-description {
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            background: #3498db;
            color: white;
            text-decoration: none;
            border-radius: 25px;
            transition: background 0.3s ease;
        }

        .back-button:hover {
            background: #2980b9;
        }

        @media (max-width: 768px) {
            .event-header {
                grid-template-columns: 1fr;
            }
            
            .event-title {
                font-size: 2rem;
            }
        }
    </style>
{% endblock %}