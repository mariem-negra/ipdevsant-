{% extends 'base.html.twig' %}

{% block title %}Gestion des événements{% endblock %}

{% block section %}
    <div class="container py-5">
        <h1 class="text-center mb-4">Gestion des événements</h1>

        <div class="card shadow-lg">
            <div class="card-body">
                <table class="table table-hover text-center align-middle">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Image</th>
                            <th>Titre</th>
                            <th>Date</th>
                            <th>Lieu</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                        <td>
                                {% if event.image %}
                                    {% set images = event.image|split(',') %}
                                    {% if images|length > 0 %}
                                        <img src="{{ asset('uploads/images/' ~ images[0]) }}" 
                                             alt="Image de {{ event.titre }}" 
                                             class="img-thumbnail" 
                                             style="max-width: 100px; height: auto;">
                                    {% endif %}
                                {% else %}
                                    <img src="{{ asset('images/no-image.png') }}" 
                                         alt="Pas d'image" 
                                         class="img-thumbnail" 
                                         style="max-width: 100px; height: auto;">
                                {% endif %}
                            </td>
                            <td>{{ event.titre }}</td>
                            <td>{{ event.dateevent ? event.dateevent|date('Y-m-d') : 'Non définie' }}</td>
                            <td>{{ event.lieu }}</td>
                            <td>{{ event.discription }}</td>
                            <td>
                                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Afficher
                                </a>
                                <a href="{{ path('app_mapb') }}?event={{ event.id }}" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-map-marker-alt"></i> Carte
                                </a>
                             <a href="{{ path('reservation_new', {'id': event.id}) }}" class="btn btn-sm btn-success">
    <i class="fas fa-ticket-alt"></i> Réserver
</a>

                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-muted">Aucun événement trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
      <button id="start-voice-search">🎤 Rechercher par voix</button>
     <input type="text" id="search-input" placeholder="Dites une catégorie..." />
 <script>
    document.getElementById("start-voice-search").addEventListener("click", function() {
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.lang = 'fr-FR';

        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript.trim(); // Supprime les espaces inutiles
            window.location.href = `/event/admin/events/search?keyword=${encodeURIComponent(transcript)}`;
        };

        recognition.start();
    });

</script>

{% endblock %}