{% extends 'base.html.twig' %}

{% block title %}Gestion des événements{% endblock %}

{% block section %}
    <div class="container py-5">
        <h1 class="text-center mb-4">Gestion des événements</h1>

        <div class="card shadow-lg">
            <div class="card-body">
                <table class="table table-hover text-center align-middle">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th>Titre</th>
                            <th>Date</th>
                            <th>Lieu</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                            <td>{{ event.titre }}</td>
                            <td>{{ event.dateevent ? event.dateevent|date('Y-m-d') : 'Non définie' }}</td>
                            <td>{{ event.lieu }}</td>
                            <td>{{ event.discription }}</td>
                            <td>
                                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Afficher
                                </a>
                             <a href="{{ path('reservation_new', {'id': event.id}) }}" class="btn btn-sm btn-success">
    <i class="fas fa-ticket-alt"></i> Réserver
</a>

                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-muted">Aucun événement trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}