{% extends 'baseBack.html.twig' %}

{% block title %}Détails Événement{% endblock %}

{% block main %}
<div class="admin-event-container">
    <h1 class="admin-event-title">{{ event.titre }}</h1>

    <!-- Galerie d'images -->
    <div class="admin-gallery">
        {% for image in event.image|split(',') %}
            {% set imagePath = asset('uploads/images/' ~ image) %}
            <div class="gallery-item">
                <a href="{{ imagePath }}" data-lightbox="event-gallery">
                    <img src="{{ imagePath }}" alt="Image événement" class="gallery-image">
                </a>
            </div>
        {% endfor %}
    </div>

    <!-- Détails de l'événement -->
    <div class="admin-event-details">
        <table class="admin-detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ event.id }}</td>
                </tr>
                <tr>
                    <th>Titre</th>
                    <td>{{ event.titre }}</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>{{ event.dateevent ? event.dateevent|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                    <th>Lieu</th>
                    <td>{{ event.lieu }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ event.discription }}</td>
                </tr>
                <tr>
                    <th>Images</th>
                    <td>{{ event.image|split(',')|length }} fichier(s)</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Actions -->
    <div class="admin-event-actions">
        <a href="{{ path('app_event_indexback') }}" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-edit">
            <i class="fas fa-edit"></i> Modifier
        </a>
        {{ include('event/_delete_form.html.twig') }}
    </div>
</div>

<style>
    .admin-event-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 20px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
    }

    .admin-event-title {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 2.2rem;
    }

    .admin-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .gallery-item {
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.3s ease;
        background: #f8f9fa;
    }

    .gallery-item:hover {
        transform: translateY(-3px);
    }

    .gallery-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border: 1px solid #eee;
    }

    .admin-detail-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 2rem;
    }

    .admin-detail-table th,
    .admin-detail-table td {
        padding: 12px 15px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    .admin-detail-table th {
        background: #f8f9fa;
        width: 200px;
    }

    .admin-event-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .btn {
        padding: 0.8rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-back {
        background: #6c757d;
        color: white;
    }

    .btn-edit {
        background: #3498db;
        color: white;
    }

    .btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .admin-gallery {
            grid-template-columns: repeat(2, 1fr);
        }
        
        .admin-event-title {
            font-size: 1.8rem;
        }
    }
</style>
{% endblock %}