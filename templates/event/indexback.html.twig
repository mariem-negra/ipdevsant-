{% extends 'baseBack.html.twig' %}

{% block title %}Gestion des événements{% endblock %}

{% block main %}
    <div class="container py-5">
        <h1 class="text-center mb-4">Gestion des événements</h1>
        
        <div class="card shadow-lg border-primary">
            <div class="card-body">
                <!-- Formulaire de recherche -->
                <form method="get" action="{{ path('app_event_indexr') }}" class="mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="text" name="keyword" class="form-control" placeholder="Rechercher par titre..." 
                                       value="{{ app.request.query.get('keyword') }}" title="Entrez le titre de l'événement">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search"></i> Rechercher

                                </button>
                            </div>
                        </div>
                        <div class="col-md-4 text-end mt-2 mt-md-0">
                            <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-repeat"></i> Réinitialiser
                            </a>
                        </div>
                    </div>
                </form>
                
                {% if app.request.query.get('keyword') and events|length == 0 %}
                    <div class="alert alert-danger text-center">
                        Aucun événement trouvé pour "{{ app.request.query.get('keyword') }}".
                    </div>
                {% endif %}
                
               <table class="table table-hover text-center align-middle">
    <thead class="bg-primary text-white">
        <tr>
            <th>Id</th>
            <th>Image</th>
            <th>Titre</th>
            <th>Date</th>
            <th>Lieu</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>Description</th>
            <th>Nombre de places</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for event in events %}
        <tr>
        
            <td><strong>{{ event.id }}</strong></td>
            <td>
                                {% if event.image %}
                                    {% set images = event.image|split(',') %}
                                    {% if images|length > 0 %}
                                        <img src="{{ asset('uploads/images/' ~ images[0]) }}" 
                                             alt="Image de {{ event.titre }}" 
                                             class="img-thumbnail" 
                                             style="max-width: 100px; height: auto;">
                                    {% endif %}
                                {% else %}
                                    <img src="{{ asset('images/no-image.png') }}" 
                                         alt="Pas d'image" 
                                         class="img-thumbnail" 
                                         style="max-width: 100px; height: auto;">
                                {% endif %}
                            </td>
            <td>{{ event.titre }}</td>
            <td>{{ event.dateevent ? event.dateevent|date('Y-m-d') : 'Non définie' }}</td>
            <td>{{ event.lieu }}</td>
            <td>{{ event.latitude }}</td>
            <td>{{ event.longitude }}</td>
            <td>{{ event.discription }}</td>
            <td>{{ event.nbplace }}</td>
            <td>
                <a href="{{ path('app_event_showback', {'id': event.id}) }}" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil"></i>
                </a>
                <form action="{{ path('app_event_delete', {'id': event.id}) }}" method="post" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="9" class="text-muted">
                {% if app.request.query.get('keyword') %}
                    Aucun événement trouvé pour "{{ app.request.query.get('keyword') }}".
                {% else %}
                    Aucun événement trouvé.
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
                
                <!-- Bouton Ajouter dans la colonne Actions -->
                <div class="text-center mt-3">
                    <a href="{{ path('app_event_new') }}" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-plus-circle"></i> Ajouter un événement
                    </a>
                </div>
            </div>
        </div>
       
    </div>
       <button id="start-voice-search">🎤 Rechercher par voix</button>
     <input type="text" id="search-input" placeholder="Dites une catégorie..." />
 <script>
    document.getElementById("start-voice-search").addEventListener("click", function() {
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.lang = 'fr-FR';

        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript.trim(); // Supprime les espaces inutiles
            window.location.href = `/event/admin/events/search?keyword=${encodeURIComponent(transcript)}`;
        };

        recognition.start();
    });

</script>

{% endblock %}