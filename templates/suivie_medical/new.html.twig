{% extends 'base.html.twig' %}

{% block title %}Nouveau Suivi Médical{% endblock %}

{% block section %}
<style>
    /* Medical Theme Base */
    :root {
        --medical-green: #00bf9a;
        --medical-blue: #4a90e2;
        --light-green: #e7f9f7;
        --dark-green: #00957b;
        --accent-blue: #2c3e50;
    }

    .table-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        background: linear-gradient(135deg, #f8fffd 0%, #e7f9f7 100%);
        border-radius: 20px;
        box-shadow: 
            0 10px 20px rgba(0, 191, 154, 0.1),
            0 6px 6px rgba(0, 191, 154, 0.1);
        position: relative;
        overflow: hidden;
    }

    /* Medical Pattern Background */
    .table-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 10% 20%, transparent 20%, var(--medical-green) 21%, var(--medical-green) 22%, transparent 23%) 0 0/60px 60px,
            radial-gradient(circle at 90% 80%, transparent 20%, var(--medical-green) 21%, var(--medical-green) 22%, transparent 23%) 30px 30px/60px 60px;
        opacity: 0.03;
        z-index: 0;
    }

    /* 3D Header with Medical Icon */
    h1 {
        color: var(--medical-green);
        font-size: 2.25rem;
        font-weight: 800;
        margin-bottom: 2rem;
        padding: 1rem 1.5rem;
        background: white;
        border-radius: 15px;
        box-shadow: 
            0 4px 6px rgba(0, 191, 154, 0.1),
            0 1px 3px rgba(0, 191, 154, 0.1);
        transform: perspective(1000px) translateZ(0);
        transition: transform 0.3s ease;
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    h1::before {
        content: '💊';
        font-size: 2rem;
        margin-right: 1rem;
    }

    /* 3D Patient Info Card */
    .patient-info {
        background: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        border-left: 5px solid var(--medical-green);
        transform: perspective(1000px) translateZ(0);
        box-shadow: 
            0 15px 25px rgba(0, 191, 154, 0.1),
            0 5px 10px rgba(0, 191, 154, 0.05);
        transition: all 0.3s ease;
        position: relative;
    }

    .patient-info:hover {
        transform: perspective(1000px) translateZ(20px);
    }

    .patient-info h3 {
        color: var(--medical-green);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .patient-info h3::before {
        content: '👤';
        font-size: 1.5rem;
    }

    /* Enhanced Info Grid with 3D Effects */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .info-item {
        background: var(--light-green);
        padding: 1.5rem;
        border-radius: 12px;
        transform: translateZ(0);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .info-item:hover {
        transform: translateY(-5px);
        box-shadow: 
            0 10px 20px rgba(0, 191, 154, 0.1),
            0 6px 6px rgba(0, 191, 154, 0.1);
    }

    .info-label {
        color: var(--dark-green);
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-label::before {
        content: '📋';
        font-size: 1.2rem;
    }

    .info-value {
        color: var(--accent-blue);
        background: white;
        padding: 1rem;
        border-radius: 8px;
        border: 2px solid rgba(0, 191, 154, 0.1);
        font-size: 1.1rem;
        transform: translateZ(0);
    }

    /* Modern Medical Form Style */
    .form-group {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        box-shadow: 
            0 4px 6px rgba(0, 191, 154, 0.1),
            0 1px 3px rgba(0, 191, 154, 0.1);
        transform: translateZ(0);
        transition: transform 0.3s ease;
    }

    .form-group:hover {
        transform: translateY(-2px);
    }

    .form-group label {
        color: var(--dark-green);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group label::before {
        content: '📝';
        font-size: 1.2rem;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 1rem;
        border: 2px solid rgba(0, 191, 154, 0.2);
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: var(--light-green);
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--medical-green);
        box-shadow: 0 0 0 4px rgba(0, 191, 154, 0.1);
        background-color: white;
    }

    /* 3D Button Styles */
    .button-container {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn {
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        transform: translateZ(0);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-success {
        background: linear-gradient(135deg, var(--medical-green), var(--dark-green));
        color: white;
        box-shadow: 
            0 4px 15px rgba(0, 191, 154, 0.3),
            0 2px 5px rgba(0, 191, 154, 0.2);
    }

    .btn-success:hover {
        transform: translateY(-3px);
        box-shadow: 
            0 6px 20px rgba(0, 191, 154, 0.4),
            0 4px 10px rgba(0, 191, 154, 0.3);
    }

    .btn-success::before {
        content: '💾';
        font-size: 1.2rem;
    }

    .btn-back {
        background: linear-gradient(135deg, #a0aec0, #718096);
        color: white;
    }

    .btn-back::before {
        content: '⬅️';
        font-size: 1.2rem;
    }

    .btn-back:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(113, 128, 150, 0.4);
    }

    /* Error Styling */
    .form-error {
        color: #e53e3e;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        padding: 0.75rem;
        border-radius: 8px;
        background: #fff5f5;
        border-left: 4px solid #e53e3e;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-error::before {
        content: '⚠️';
        font-size: 1rem;
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
        .table-container {
            padding: 1rem;
            margin: 1rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .button-container {
            flex-direction: column-reverse;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
    
<div class="table-container">
    <h1>Nouveau Suivi Médical</h1>

    {% if patient_info %}
        <div class="patient-info">
            <h3>Informations du Traitement</h3>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Nom</span>
                    <span class="info-value">{{ patient_info.nom }}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Prénom</span>
                    <span class="info-value">{{ patient_info.prenom }}</span>
                </div>
                {% if patient_info.bilan %}
                    <div class="info-item">
                        <span class="info-label">Bilan</span>
                        <span class="info-value">
                            <img src="{{ asset('uploads/bilan/' ~ patient_info.bilan) }}" alt="Bilan" style="max-width: 100%; height: auto;">
                        </span>
                    </div>
                {% else %}
                    <div class="info-item">
                        <span class="info-label">Bilan</span>
                        <span class="info-value">Aucun bilan disponible.</span>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    <div class="form-group">
        {{ form_label(form.date) }}
        {{ form_widget(form.date) }}
        <div class="form-error">{{ form_errors(form.date) }}</div>
    </div>

    <div class="form-group">
        {{ form_label(form.commentaire) }}
        {{ form_widget(form.commentaire) }}
        <div class="form-error">{{ form_errors(form.commentaire) }}</div>
    </div>

    <div class="button-container">
        <a href="{{ path('app_suivie_medical_index_front') }}" class="btn btn-back">Retour à la liste</a>
        <button type="submit" class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}