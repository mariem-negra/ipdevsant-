{% extends 'baseBack.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
  <section id="call-to-action" class="call-to-action section accent-background">
      <div class="container">
        <div class="row justify-content-center" data-aos="zoom-in" data-aos-delay="100">
          <div class="col-xl-10">
            <div class="text-center">
              <h1>Cart Items</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Quantité</th>
                <th>Produit</th>
                <th>Commande Id</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cart_item in cart_items %}
            <tr>
                <td>{{ cart_item.id }}</td>
                <td>{{ cart_item.quantite }}</td>
                <td>{{ cart_item.produit ? cart_item.produit.nom : 'N/A' }}</td>
                <td>{{ cart_item.commande ? cart_item.commande.id : 'N/A' }}</td>
                <td>
                    <a href="{{ path('app_cart_item_showback', {'id': cart_item.id}) }}">
                        <button class="btn btn-info">Show</button>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            padding: 20px;
        }
        h1 {
            color: #333;
            text-align: center;
        }
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .table th, .table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .table th {
            background-color: rgb(53, 77, 233);
            color: white;
        }
        .table tr:hover {
            background-color: #f5f5f5;
        }
        .table a {
            color: inherit;
            text-decoration: none;
        }
        .btn {
            background-color: rgb(47, 173, 193);
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            background-color: rgb(128, 5, 194);
        }
        .btn-info {
            background-color: rgb(53, 77, 233);
        }
        .btn-warning {
            background-color: rgb(255, 165, 0);
        }
        .btn-success {
            background-color: rgb(47, 173, 193);
        }
        .btn-delete {
            background-color: rgb(255, 51, 0); /* Red color for delete */
        }
        .btn-delete:hover {
            background-color: rgb(255, 0, 0); /* Darker red on hover */
        }
    </style>
{% endblock %}