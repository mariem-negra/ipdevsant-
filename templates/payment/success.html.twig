{% extends 'base.html.twig' %}

{% block header %}
    <div class="topbar d-flex align-items-center">
      <div class="container d-flex justify-content-center justify-content-md-between">
        <div class="d-none d-md-flex align-items-center">
          <i class="bi bi-clock me-1"></i> Monday - Saturday, 8AM to 10PM
        </div>
        <div class="d-flex align-items-center">
          <i class="bi bi-phone me-1"></i> Call us now +1 5589 55488 55
        </div>
      </div>
    </div><!-- End Top Bar -->
    

    <div class="branding d-flex align-items-center">

      <div class="container position-relative d-flex align-items-center justify-content-end">
        <a href='#' class="logo d-flex align-items-center me-auto" style="max-width: 200px;"> <!-- Adjust max-width as needed -->
          <img src="{{ asset('img/logo.png') }}" alt="Logo" class="img-fluid" style="width: 200%; height: auto;">
        </a>
        <nav id="navmenu" class="navmenu">
            <ul>
                <li><a href="{{ path('app_home') }}" class="active">Acceuil</a></li>
                <li><a href="{{ path('app_home') }}">Consernant</a></li>
                <li><a href="{{ path('app_home') }}">Services</a></li>
                <li><a href="{{ path('app_home') }}">Departments</a></li>
                <li><a href="{{ path('app_produit_display') }}#produit">Produit</a></li>
                <li><a href="{{ path('app_home') }}">Médecin</a></li>
                <li><a href="{{ path('app_home') }}">Contact</a></li>
                
            </ul>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
        </nav>
        <a class="cta-btn" href="{{ path('app_profile') }}">Mon Profile</a>

      </div>
      <a href="{{ path('app_panier') }}" class="cart-icon-wrapper">
      <div class="cart-icon">
        <i class="bi bi-cart3"></i>
        <span class="cart-count">{{ app.session.get('panier')|length|default(0) }}</span>
      </div>
    </a>
    </div>

  </header>
   <style>
    .cart-icon-wrapper {
  position: relative;
  display: inline-block;
  margin-right: 50px;
  text-decoration: none;
}

.cart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #30b4b4; /* Using your teal brand color */
  color: white;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.cart-icon:hover {
  background-color: #2a9d9d;
  transform: scale(1.05);
}

.cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  background-color:rgb(47, 63, 241);
  color: white;
  font-size: 12px;
  font-weight: bold;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid white;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}
</style>
{% endblock %}

{% block main %}
<section class="order-status">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 text-center">
                {% if orderStatus == 'completed' %}
                    <div class="success-box">
                        <i class="bi bi-check-circle-fill success-icon"></i>
                        <h2 class="success-title">Paiement Réussi !</h2>
                        <p class="success-message">Votre commande <strong>#{{ orderId }}</strong> a été confirmée avec succès.</p>
                        <p class="success-text">Merci pour votre achat ! Nous espérons vous revoir bientôt.</p>
                        <a href="{{ path('app_produit_index') }}" class="btn btn-primary">Continuer vos achats</a>
                    </div>
                {% else %}
                    <div class="warning-box">
                        <i class="bi bi-hourglass-split warning-icon"></i>
                        <h2 class="warning-title">Traitement du paiement</h2>
                        <p class="warning-message">Nous confirmons votre paiement. Veuillez patienter...</p>
                        <a href="{{ path('app_produit_index') }}" class="btn btn-secondary">Retour aux produits</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<style>
    .order-status {
        padding: 100px 0;
        background-color: #f9f9f9;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
    }

    .success-box, .warning-box {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 600px;
        margin: auto;
    }

    .success-icon {
        font-size: 60px;
        color: #30b4b4;
        margin-bottom: 20px;
    }

    .warning-icon {
        font-size: 60px;
        color: #f39c12;
        margin-bottom: 20px;
    }

    .success-title, .warning-title {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .success-message, .warning-message {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .success-text {
        font-size: 16px;
        color: #666;
        margin-bottom: 20px;
    }

    .btn-primary {
        background-color: #30b4b4;
        border: none;
        padding: 12px 24px;
        font-size: 18px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #2a9d9d;
    }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
        padding: 12px 24px;
        font-size: 18px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
    }
</style>
{% endblock %}
