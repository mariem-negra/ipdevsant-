{% extends 'base.html.twig' %}

{% block title %}Créer un rendez-vous{% endblock %}

{% block section %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-calendar-plus"></i> Créer un nouveau rendez-vous
                    </h3>
                </div>
                <div class="card-body">
                    {# Flash messages - Success and Error #}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    {% endfor %}

                    {# Form rendering #}
                    {% if form is defined %}
                        <form method="POST" action="{{ path('app_rendez_vous_new') }}">
                            <div class="form-group">
                                {{ form_label(form.dateheure, 'Date et Heure du rendez-vous', {'class': 'font-weight-bold'}) }}
                                {{ form_widget(form.dateheure, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.dateheure) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.statut, 'Statut', {'class': 'font-weight-bold'}) }}
                                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.statut) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.description, 'Description', {'class': 'font-weight-bold'}) }}
                                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.planning, 'Planning du médecin', {'class': 'font-weight-bold'}) }}
                                {{ form_widget(form.planning, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.planning) }}
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-success btn-block">
                                    <i class="fas fa-check-circle"></i> Enregistrer le rendez-vous
                                </button>
                            </div>
                        </form>
                    {% else %}
                        <div class="alert alert-warning">
                            Erreur : Le formulaire n'a pas été correctement chargé.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
