{% extends 'base.html.twig' %}

{% block title %}Détails du planning{% endblock %}

{% block body %}
    <h1>Détails du planning</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ planning.id }}</td>
            </tr>
            <tr>
                <th>Jour</th>
                <td>{{ planning.jour }}</td>
            </tr>
            <tr>
                <th>Heure de début</th>
                <td>{{ planning.heuredebut|date('H:i') }}</td>
            </tr>
            <tr>
                <th>Heure de fin</th>
                <td>{{ planning.heurefin|date('H:i') }}</td>
            </tr>
        </tbody>
    </table>

    <div class="button-container">
        <a href="{{ path('app_planning_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_planning_edit', {'id': planning.id}) }}" class="btn btn-warning">Modifier</a>
        {{ include('planning/_delete_form.html.twig') }}
    </div>
{% endblock %}
