{# _form.html.twig #}

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="form-group">
    {{ form_label(form.jour) }}
    {{ form_widget(form.jour) }}
    {% for error in form.jour.vars.errors %}
        <div class="text-danger">{{ error.message }}</div>
    {% endfor %}
</div>

<div class="form-group">
    {{ form_label(form.heuredebut) }}
    {{ form_widget(form.heuredebut) }}

</div>

<div class="form-group">
    {{ form_label(form.heurefin) }}
    {{ form_widget(form.heurefin) }}
    {% for error in form.heurefin.vars.errors %}
        <div class="text-danger">{{ error.message }}</div>
    {% endfor %}
</div>

<button class="btn">{{ button_label|default('Enregistrer') }}</button>

{{ form_end(form) }}