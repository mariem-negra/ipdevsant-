{% extends 'baseBack.html.twig' %}

{% block body %}
<div class="container py-5">
    <header class="text-center mb-5">
        <h1 class="title">Vérifications de Médecin</h1>
        <p class="subtitle">Gérez les demandes de vérification des médecins inscrits.</p>
    </header>

    {% for doctor in doctors %}
    <div class="card">
        <div class="card-header">
            <h5 class="doctor-name">
                <span class="icon"><i class="bi bi-hospital"></i></span>

                {{ doctor.prenom }} {{ doctor.nom }}
            </h5>
            <span class="status-badge">En attente de vérification</span>
        </div>
        <div class="card-body">
            <div class="details">
                <p>
                    <span class="input-group-text email-icon"><i class="bi bi-envelope"></i></span>
                    <strong>Email:</strong> {{ doctor.email }}
                </p>
                <p>
                    <span class="input-group-text dob-icon"><i class="bi bi-calendar"></i></span>
                    <strong>Date de naissance:</strong> {{ doctor.dateNaissance ? doctor.dateNaissance|date('Y-m-d') : '' }}
                </p>
                <p>
                    <span class="input-group-text phone-icon"><i class="bi bi-telephone"></i></span>
                    <strong>Téléphone:</strong> {{ doctor.telephone }}
                </p>
                <p>
                    <span class="input-group-text specialty-icon"><i class="bi bi-heart-pulse"></i></span>
                    <strong>Spécialité:</strong> {{ doctor.specialite }}
                </p>

                {% if doctor.diploma %}
                    <p>
                        <span class="input-group-text diploma-icon"><i class="bi bi-file-earmark-pdf"></i></span>
                        <strong>Diplôme:</strong>
                        <a href="{{ asset('uploads/diplomas/' ~ doctor.diploma) }}" target="_blank" class="diploma-link">
                            Voir le diplôme
                        </a>
                    </p>
                {% endif %}
            </div>
            <div class="actions">
                <form action="{{ path('admin_verify_doctor', {'id': doctor.id}) }}" method="POST">
                    <button type="submit" class="verify-button">
                        <span class="input-group-text verify-icon"><i class="bi bi-check-circle"> vérifier</i></span>
                        
                    </button>
                </form>
            </div>
        </div>
    </div>
    {% else %}
    <div class="no-pending">
        <p>Aucune vérification de médecin en attente.</p>
    </div>
    {% endfor %}
</div>
<style>
.doctor-name {
    font-size: 1.8rem;
    font-weight: bold;
    color: #34495e; /* Dark blue for the name */
    margin: 0;
    display: flex;
    align-items: center;
}

.doctor-name .icon {
    margin-right: 10px;
    font-size: 1.5rem;
    color: #e74c3c; /* Red for the doctor icon */
    transition: transform 0.3s ease;
}

.doctor-name:hover .icon {
    transform: scale(1.1); /* Slightly enlarge icon on hover */
}
    body {
        font-family: Arial, sans-serif;
        background-color: #f8f9fa;
        color: #333;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    /* Header Styles */
    .title {
        font-size: 2.5rem;
        font-weight: bold;
        color:rgb(77, 219, 195); /* Dark blue for the title */
    }

    .subtitle {
        font-size: 1.2rem;
        color:rgb(63, 196, 236); /* Blue for the subtitle */
    }

    /* Card Styles */
    .card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-header {
        background: #ecf0f1;
        padding: 15px;
        border-bottom: 2px solid #bdc3c7;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .doctor-name {
        font-size: 1.5rem;
        margin: 0;
        color: #34495e;
    }

     .status-badge {
        background: #f1c40f;
        color: #000;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 0.9rem;
    }
    .card-body {
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .details p {
        margin: 10px 0;
        font-size: 1rem;
        display: flex;
        align-items: center;
    }

    .input-group-text {
        margin-right: 10px;
        font-size: 1.2rem;
    }

    /* Icon Colors */
    .email-icon {
        color: #3498db; /* Blue for email */
    }

    .dob-icon {
        color: #e67e22; /* Orange for date of birth */
    }

    .phone-icon {
        color: #9b59b6; /* Purple for phone */
    }

    .specialty-icon {
        color: #e74c3c; /* Red for specialty */
    }

    .diploma-icon {
        color: #2ecc71; /* Green for diploma */
    }

    .verify-icon {
        color: #2ecc71; /* White for verify button icon */
    }

    .diploma-link {
        color: #e74c3c;
        text-decoration: none;
    }

    .diploma-link:hover {
        text-decoration: underline;
    }

    .verify-button {
        background: none; /* No background */
        border: none;
        padding: 0;
        cursor: pointer;
        font-size: 1.5rem;
        color: #2ecc71; /* Green for the icon */
        transition: color 0.3s ease;
    }

    .verify-button:hover {
        color: #27ae60; /* Darker green on hover */
    }

    /* No Pending Styles */
    .no-pending {
        text-align: center;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .no-pending p {
        margin: 0;
        font-size: 1.2rem;
        color: #7f8c8d;
    }
</style>
{% endblock %}