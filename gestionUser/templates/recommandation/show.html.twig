{% extends 'baseBack.html.twig' %}

{% block title %}Détails de la Recommandation{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Détails de la Recommandation</h1>

    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <th scope="row">Petit Déjeuner</th>
                <td>{{ recommandation.PetitDejeuner ?: '<span class="text-muted">Non défini</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Déjeuner</th>
                <td>{{ recommandation.Dejeuner ?: '<span class="text-muted">Non défini</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Dîner</th>
                <td>{{ recommandation.Diner ?: '<span class="text-muted">Non défini</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Activité</th>
                <td>{{ recommandation.Activity ?: '<span class="text-muted">Aucune</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Calories</th>
                <td>{{ recommandation.Calories }} kcal</td>
            </tr>
            <tr>
                <th scope="row">Durée</th>
                <td>{{ recommandation.Duree }} h</td>
            </tr>
            <tr>
                <th scope="row">Suppléments</th>
                <td>{{ recommandation.Supplements ?: '<span class="text-muted">Aucun</span>'|raw }}</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-4 text-center">
        <a href="{{ path('app_recommandation_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>

        <a href="{{ path('app_recommandation_edit', {'id': recommandation.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Modifier
        </a>

        <div class="d-inline-block">
            {{ include('recommandation/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
