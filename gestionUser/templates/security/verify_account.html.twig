{# templates/security/verify_account.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Vérification de compte{% endblock %}

{% block body %}
<div class="verify-container">
  <div class="verify-card">
    <div class="verify-header">
      <img src="{{ asset('img/logo.png') }}" alt="Logo" class="verify-logo">
      <h1 class="verify-title">Vérification de sécurité</h1>
    </div>
    
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }}">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}
    
    <div class="verify-info">
      <p>Pour débloquer votre compte, veuillez saisir le code à usage unique (OTP) qui vous a été envoyé par email.</p>
      <p>Ce code expire dans <strong>30 minutes</strong>.</p>
    </div>
    
    <form method="post" action="{{ path('security_verify_otp', {token: token}) }}" class="verify-form">
      <div class="form-group">
        <label for="otp">Code à usage unique (6 chiffres)</label>
        <input type="text" name="otp" id="otp" class="form-control" placeholder="Entrez le code à 6 chiffres" 
               pattern="[0-9]{6}" maxlength="6" required>
      </div>
      
      <button class="btn btn-primary btn-block" type="submit">
        Vérifier et débloquer
      </button>
      
      <div class="verify-actions">
        <a href="{{ path('app_login') }}" class="verify-link">Retour à la page de connexion</a>
      </div>
    </form>
  </div>
</div>

<style>
  body {
    background: linear-gradient(-45deg, #3fbbc0, #2a9d9f, #1c7a7d, #0d4d4f);
    background-size: 400% 400%;
    animation: gradient 15s ease infinite;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    font-family: 'Poppins', sans-serif;
  }

  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .verify-container {
    width: 100%;
    max-width: 500px;
    padding: 20px;
  }

  .verify-card {
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    padding: 30px;
  }

  .verify-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .verify-logo {
    max-width: 150px;
    height: auto;
    margin-bottom: 20px;
  }

  .verify-title {
    font-size: 28px;
    font-weight: 600;
    color: #036EB8;
    margin-bottom: 10px;
  }

  .verify-info {
    margin-bottom: 20px;
    padding: 15px;
    background-color: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #3fbbc0;
  }

  .verify-form .form-group {
    margin-bottom: 20px;
  }

  .verify-form .form-group label {
    font-size: 14px;
    color: #036EB8;
    margin-bottom: 5px;
    display: block;
  }

  .verify-form .form-control {
    width: 100%;
    padding: 12px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    font-size: 18px;
    letter-spacing: 5px;
    text-align: center;
    color: #036EB8;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .verify-form .btn-primary {
    width: 100%;
    background-color: #3fbbc0;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 16px;
    font-weight: 500;
    color: #fff;
    transition: background-color 0.3s ease;
  }

  .verify-form .btn-primary:hover {
    background-color: #2a9d9f;
  }

  .verify-actions {
    text-align: center;
    margin-top: 20px;
  }

  .verify-link {
    color: #036EB8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .verify-link:hover {
    color: #3fbbc0;
    text-decoration: underline;
  }

  .alert {
    padding: 12px;
    margin-bottom: 20px;
    border-radius: 8px;
  }

  .alert-error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .alert-success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
</style>
{% endblock %}