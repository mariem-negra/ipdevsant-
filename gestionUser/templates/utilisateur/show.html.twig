{% extends 'baseBack.html.twig' %}

{% block title %}Détails de l'utilisateur{% endblock %}

{% block body %}
<section class="section dashboard">
    <div class="card shadow-lg p-4">
        <h5 class="card-title text-primary">Détails de l'utilisateur</h5>

        <table class="table table-hover table-bordered">
            <tbody>
                <tr>
                    <th class="bg-light text-dark">ID</th>
                    <td>{{ utilisateur.id }}</td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Nom</th>
                    <td>{{ utilisateur.nom }}</td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Prénom</th>
                    <td>{{ utilisateur.prenom }}</td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Email</th>
                    <td>{{ utilisateur.email }}</td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Mot de Passe</th>
                    <td>
                        <span class="text-muted">********</span> {# Hidden for security #}
                    </td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Rôle</th>
                    <td>
                        <span class="badge 
                            {% if utilisateur.role.value == 'ROLE_ADMIN' %} bg-danger
                            {% elseif utilisateur.role.value == 'ROLE_MEDECIN' %} bg-success
                            {% else %} bg-primary {% endif %}">
                            {{ utilisateur.role.value }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Date de Naissance</th>
                    <td>{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('Y-m-d') : '-' }}</td>
                </tr>
                                    
                    {% if utilisateur.role.value == 'Médecin' %}
                    <tr>
                        <th class="bg-light text-dark">Spécialité :</th>

                    <td>  
                      <div class="row mb-4 align-items-center">
                        <div class="col-md-8 fw-medium">{{ utilisateur.specialite }}</div>
                      </div>
                      {% endif %}</td>
                </tr>
                        <!-- Diploma Field (Visible only for Médecin) -->
                {% if utilisateur.role.value == 'Médecin' and utilisateur.diploma %}
                <tr>
                    <th class="bg-light text-dark">Diplome</th>
                    <td>  
                        <div class="row mb-4 align-items-center">
                          <div class="col-md-8 fw-medium">
                            <img src="{{ asset('uploads/diplomas/' ~ utilisateur.diploma) }}" class="rounded-circle mb-3 profile-image" width="120" height="120">
                            <br>
                            <a href="{{ asset('uploads/diplomas/' ~ utilisateur.diploma) }}" target="_blank">Télécharger le diplôme</a>
                          </div>
                        </div>
                      {% endif %}
                    </td>
                </tr>
                <tr>
                    <th class="bg-light text-dark">Téléphone</th>
                    <td>{{ utilisateur.telephone }}</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_utilisateur_index') }}" class="btn btn-dark">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
            
            <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-success">
                <i class="bi bi-pencil"></i> Modifier
            </a>

            {{ include('utilisateur/_delete_form.html.twig') }}
        </div>
    </div>
</section>
{% endblock %}
