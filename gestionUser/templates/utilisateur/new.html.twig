{% block body %}
    <style>
        body {
            background: linear-gradient(135deg, #f0f8ff, #e6f7ff);
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            flex-direction: column; /* Stack title and form vertically */
        }

        .form-container {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            padding: 30px;
            max-width: 600px;
            width: 100%;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-top: 20px; /* Add space between title and form */
        }

        .form-container:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        }

        .form-label {
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .input-group {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            background: rgba(255, 255, 255, 0.9);
            border: 2px solid rgba(63, 187, 192, 0.3);
            border-radius: 12px;
            overflow: hidden;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .input-group:hover {
            border-color: #3fbbc0;
            box-shadow: 0 0 10px rgba(63, 187, 192, 0.3);
        }

        .input-group-text {
            background: linear-gradient(135deg, #3fbbc0, #2a9d8f);
            padding: 12px;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            font-size: 18px;
        }

        .form-input {
            border: none;
            padding: 12px;
            width: 100%;
            font-size: 16px;
            background: transparent;
            outline: none;
        }

        .form-input:focus {
            background: rgba(63, 187, 192, 0.05);
        }

        .error-message {
            color: #e63946;
            font-size: 14px;
            margin-top: 5px;
        }

        .submit-button {
            background: linear-gradient(135deg, #3fbbc0, #2a9d8f);
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            color: #ffffff;
            font-size: 16px;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            width: 100%;
            margin-top: 20px;
        }

        .submit-button:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 20px rgba(63, 187, 192, 0.3);
        }

        .submit-button:active {
            transform: scale(0.95);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .specialite-group {
            margin-top: 20px;
        }

        /* Animation for form container */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-container {
            animation: fadeIn 0.8s ease-out;
        }
    </style>

    <div class="form-container">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'registration-form', 'enctype': 'multipart/form-data'}}) }}

            <div class="form-group">
                <label class="form-label" for="{{ form.nom.vars.id }}">Nom</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.nom) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.prenom.vars.id }}">Prénom</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.prenom) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.email.vars.id }}">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    {{ form_widget(form.email, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.email) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.motDePasse.vars.id }}">Mot de passe</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    {{ form_widget(form.motDePasse, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.motDePasse) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.role.vars.id }}">Rôle</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                    {{ form_widget(form.role, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.role) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.dateNaissance.vars.id }}">Date de naissance</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                    {{ form_widget(form.dateNaissance, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.dateNaissance) }}</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="{{ form.telephone.vars.id }}">Téléphone</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="error-message">{{ form_errors(form.telephone) }}</div>
            </div>

            {% if form.specialite is defined %}
                <div class="form-group specialite-group">
                    <label class="form-label" for="{{ form.specialite.vars.id }}">Spécialité</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tools"></i></span>
                        {{ form_widget(form.specialite, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="error-message">{{ form_errors(form.specialite) }}</div>
                </div>
            {% endif %}
            {% if form.diploma is defined %}
                <div class="form-group specialite-group">
                    <label class="form-label" for="{{ form.diploma.vars.id }}">Diplôme</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-file-earmark-pdf"></i></span>
                        {{ form_widget(form.diploma, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="error-message">{{ form_errors(form.diploma) }}</div>
                </div>
            {% endif %}

            <div class="form-group">
                <button type="submit" class="submit-button">
                    Enregistrer
                </button>
            </div>

        {{ form_end(form) }}
    </div>

    <!-- Include Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">

{% endblock %}