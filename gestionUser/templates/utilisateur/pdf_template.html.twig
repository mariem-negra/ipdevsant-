{# templates/utilisateur/pdf_template.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Utilisateurs</title>
    <style>
        /* PDF-specific styles */
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        
        .pdf-header {
            text-align: center;
            margin-bottom: 20px;
            padding: 10px;
            border-bottom: 2px solid #0056b3;
        }
        
        .login-logo {
            max-height: 60px;
            display: block;
            margin: 0 auto 10px auto;
        }
        
        .card-title {
            color: #0056b3;
            font-size: 18px;
            font-weight: bold;
            margin: 5px 0;
        }
        
        .text-muted {
            color: #6c757d;
            font-size: 11px;
            margin: 5px 0;
        }
        
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .table th {
            background-color: #0056b3;
            color: white;
            font-weight: bold;
            text-align: left;
            padding: 8px;
            border: 1px solid #ddd;
        }
        
        .table td {
            padding: 8px;
            border: 1px solid #ddd;
        }
        
        .table tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        
        .text-center {
            text-align: center;
        }
        
        .footer {
            text-align: center;
            font-size: 10px;
            margin-top: 20px;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        
        /* Add page breaks where needed */
        .page-break {
            page-break-after: always;
        }
    </style>
</head>
<body>
    <div class="pdf-header">
<img src="{{ app.request.schemeAndHttpHost ~ asset('img/logo.png') }}" alt="Chronoserena" class="login-logo">        <h1 class="card-title">Liste des Utilisateurs</h1>
        <p class="text-muted">Généré le {{ "now"|date("d/m/Y à H:i") }}</p>
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Date de naissance</th>
                <th>Spécialité</th>
                <th>Téléphone</th>
            </tr>
        </thead>
        <tbody>
        {% for utilisateur in utilisateurs %}
            <tr>
                <td>{{ utilisateur.id }}</td>
                <td>{{ utilisateur.nom }}</td>
                <td>{{ utilisateur.prenom }}</td>
                <td>{{ utilisateur.email }}</td>
                <td>{{ utilisateur.role.value }}</td>
                <td>{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('d/m/Y') : '' }}</td>
                <td>{{ utilisateur.specialite ?? '-' }}</td>
                <td>{{ utilisateur.telephone }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center">Aucun utilisateur trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    
    <div class="footer">
        <p>Chronoserena © {{ "now"|date("Y") }} - Document confidentiel</p>
        <p>Page 1</p>
    </div>
</body>
</html>