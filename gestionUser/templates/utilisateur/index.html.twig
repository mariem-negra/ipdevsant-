{% extends 'baseBack.html.twig' %}

{% block title %}Utilisateur index{% endblock %}

{% block body %}
<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Liste des Utilisateurs</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead >
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Mot de passe</th>
                        <th>Rôle</th>
                        <th>Date de naissance</th>
                        <th>Spécialité</th>
                        <th>Téléphone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for utilisateur in utilisateurs %}
                    <tr>
                        <td>{{ utilisateur.id }}</td>
                        <td>{{ utilisateur.nom }}</td>
                        <td>{{ utilisateur.prenom }}</td>
                        <td>{{ utilisateur.email }}</td>
                        <td>************</td>
                        <td>{{ utilisateur.role.value }}</td>
                        <td>{{ utilisateur.dateNaissance ? utilisateur.dateNaissance|date('Y-m-d') : '' }}</td>
                        <td>{{ utilisateur.specialite ?? 'NULL' }}</td>
                        <td>{{ utilisateur.telephone }}</td>
                        <td>
                            <a href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> 
                            </a>
                            <br>
                            <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> 
                            </a>
                            {{ include('utilisateur/_delete_form.html.twig') }}

                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="text-center">Aucun utilisateur trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            
            <div class="d-flex justify-content-end">
                <a href="{{ path('app_utilisateur_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Créer un nouvel utilisateur
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
