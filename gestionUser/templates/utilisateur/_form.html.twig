{% block body %}
<section class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 glass-effect" style="max-width: 500px; width: 100%;">
        <div class="card-body text-center">
            <h2 class="text-gradient mb-4">Modifier l'utilisateur</h2>

            {{ form_start(form, {'attr': {'class': 'form-horizontal','enctype': 'multipart/form-data'}}) }}

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        {{ form_widget(form.motDePasse, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        {{ form_widget(form.role, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                        {{ form_widget(form.dateNaissance, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
                    </div>
                </div>
                {# Render specialite and diploma fields above the buttons #}
                {% if form.specialite is defined %}
                    <div class="form-group">
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-file-earmark-text"></i></span>
                            {{ form_widget(form.specialite, {'attr': {'class': 'form-control', 'placeholder': 'Spécialité'}}) }}
                        </div>
                    </div>
                {% endif %}
                {% if form.diploma is defined %}
                    <div class="form-group">
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-file-earmark-arrow-up"></i></span>
                            <div class="form-control">
                                {{ form_widget(form.diploma) }}
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="d-flex justify-content-between mt-3">
                    <button type="submit" class="btn btn-primary btn-glow">
                        <i class="bi bi-save"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_utilisateur_index') }}" class="btn btn-danger btn-glow">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</section>

<style>
    /* Effet Glassmorphism */
    .glass-effect {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
        padding: 30px;
    }

    /* Dégradé sur le titre */
    .text-gradient {
        background: linear-gradient(90deg, #3fbbc0, #5ce1e6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 24px;
        font-weight: bold;
    }

    /* Effet lumineux sur les boutons */
    .btn-glow {
        transition: 0.3s ease-in-out;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }
    .btn-glow:hover {
        transform: scale(1.05);
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.3);
    }

    /* Personnalisation des champs */
    .input-group-text {
        background: #3fbbc0;
        color: white;
        border: none;
        border-radius: 8px 0 0 8px;
    }

    .form-control {
        border: none;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
        transition: 0.3s ease;
    }
    .form-control:focus {
        box-shadow: 0px 4px 15px rgba(0, 191, 255, 0.4);
        border: 1px solid #3fbbc0;
    }

    /* Adaptation responsive */
    @media (max-width: 768px) {
        .glass-effect {
            width: 90%;
        }
    }
</style>
{% endblock %}
