{% extends 'base.html.twig' %}

{% block title %}Modifier la Demande{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="mb-4 text-center text-primary">Modifier la Demande</h2>

        <div class="card shadow p-4">
            {{ include('demande/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>

        <div class="mt-3 text-center">
            <a href="{{ path('app_demande_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            {{ include('demande/_delete_form.html.twig', {'attr': {'class': 'd-inline'}}) }}
        </div>
    </div>
{% endblock %}
