{% extends 'base.html.twig' %}

{% block title %}Détails de la Demande{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Détails de la Demande</h1>

    <table class="table table-bordered table-striped">
        <tbody>
            
            <tr>
                <th scope="row">Date</th>
                <td>{{ demande.Date ? demande.Date|date('Y-m-d') : '<span class="text-muted">Non définie</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Eau</th>
                <td>{{ demande.Eau }} L</td>
            </tr>
            <tr>
                <th scope="row">Nombre de Repas</th>
                <td>{{ demande.NbrRepas }}</td>
            </tr>
            <tr>
                <th scope="row">Snacks</th>
                <td>
                    <span class="badge {{ demande.Snacks ? 'bg-success' : 'bg-danger' }}">
                        {{ demande.Snacks ? 'Oui' : 'Non' }}
                    </span>
                </td>
            </tr>
            <tr>
                <th scope="row">Calories</th>
                <td>{{ demande.Calories }} kcal</td>
            </tr>
            <tr>
                <th scope="row">Activité</th>
                <td>{{ demande.Activity ?: '<span class="text-muted">Aucune</span>'|raw }}</td>
            </tr>
            <tr>
                <th scope="row">Sommeil</th>
                <td>{{ demande.Sommeil }} </td>
            </tr>
            <tr>
                <th scope="row">Durée d'Activité</th>
                <td>{{ demande.DureeActivite }} h</td>
            </tr>
        </tbody>
    </table>

    <div class="mt-4 text-center">
        <a href="{{ path('app_demande_dashboard') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au Dashboard 
        </a>

        <a href="{{ path('app_demande_edit', {'id': demande.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Modifier
        </a>

        <div class="d-inline-block">
            {{ include('demande/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
