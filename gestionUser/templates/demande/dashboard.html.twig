{% extends 'base.html.twig' %}

{% block title %}Tableau de bord des Demandes{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="section-title text-center" data-aos="fade-up">
        <h2>Tableau de bord des Demandes</h2>
        <p>Accédez rapidement à vos demandes et créez-en de nouvelles</p>
    </div>
    <div class="row justify-content-center">
        <!-- Card for creating a new Demande -->
        <div class="col-xl-3 col-md-6 d-flex" data-aos="fade-up" data-aos-delay="100">
            <div class="service-item position-relative">
                <div class="icon">
                    <i class="fas fa-plus-circle icon"></i>
                </div>
                <h4>
                    <a href="{{ path('app_demande_new') }}" class="stretched-link">
                        Nouvelle Demande
                    </a>
                </h4>
                <p>Créez une nouvelle demande pour suivre votre mode de vie.</p>
            </div>
        </div>
        <!-- Card for viewing the current Demande -->
        <div class="col-xl-3 col-md-6 d-flex" data-aos="fade-up" data-aos-delay="200">
            <div class="service-item position-relative">
                <div class="icon">
                    <i class="fas fa-eye icon"></i>
                </div>
                <h4>
                    <a href="{{ path('app_demande_my') }}" class="stretched-link">
                        Voir ma Demande
                    </a>
                </h4>
                <p>Visualisez et modifiez la demande que vous avez soumise.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
